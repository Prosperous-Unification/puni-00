node_modules
dist
.git
.nx
.worktrees
**/*.test.ts
docs
openspec
coverage

# Local dev secrets and per-developer scratch state. Runtime env vars are
# supplied by `docker run -e` / compose, never baked into the image.
**/.env
**/.env.local

# Per-developer scratch SQLite databases; the app opens DB_PATH from a
# mounted volume, not a file baked into the image. Must be **/*.db, not
# *.db: .dockerignore patterns are NOT applied recursively like .gitignore's
# are — a bare *.db only matches at the build-context root, so
# apps/be-01/local.db was landing inside the published production image
# (verified: `docker run --rm <image> ls apps/be-01` listed local.db) until
# this was made recursive.
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Development entrypoints: the local solver with its spawner, and the activated
# organization server with its fixture secrets. They must not reach
# the production image: `COPY apps/wbs/be-01` takes the whole app, and the boundary
# is this exclusion rather than the directory name.
apps/wbs/be-01/src/dev

# Test fixtures, including the organization browser server with the public test
# JWT key. Nothing the image runs imports them; `production-entrypoint.test.ts`
# bundles every image entrypoint and fails if one reaches `src/testing`.
apps/wbs/be-01/src/testing
