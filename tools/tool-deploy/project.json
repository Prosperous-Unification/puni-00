{
  "name": "tool-deploy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/tool-deploy/src",
  "projectType": "library",
  "tags": ["scope:infra", "type:scripts", "runtime:bun", "ring:adapter"],
  "targets": {
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/tool-deploy/src/deploy.ts"
      },
      "cache": false,
      "dependsOn": [
        {
          "projects": ["tool-remote-scripts"],
          "target": "build"
        },
        {
          "projects": ["tool-smoke"],
          "target": "build"
        }
      ]
    },
    "deploy:k3s": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-deploy/src/k8s/deploy-k3s.ts"
      }
    },
    "descriptor": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-deploy/src/k8s/descriptor-cli.ts"
      }
    },
    "rehearse:cutover": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-deploy/src/k8s/cutover-rehearsal.ts"
      }
    },
    "cutover": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-deploy/src/k8s/cutover-cli.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/bin/assert-no-prod-release.sh",
        "{workspaceRoot}/apps/wbs/be-01/**/*",
        "{workspaceRoot}/deploy/k8s/wbs/overlays/**/*",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/.github/workflows/deploy-k3s.yml",
        "{workspaceRoot}/.github/workflows/infra-check.yml",
        "{workspaceRoot}/tools/tool-devsync/src/bureaucrat-consumer.ts"
      ],
      "options": {
        "command": "bun test --preload ../test/scratch/preload.ts",
        "cwd": "tools/tool-deploy"
      }
    },
    "test:k3s": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-deploy/src/k8s/lab.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-deploy/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-deploy/src --cache --cache-location .nx/eslintcache-tool-deploy"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force tools/tool-deploy/tsconfig.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{workspaceRoot}/bin/assert-no-prod-release.sh"],
      "options": {
        "commands": [
          "command -v shellcheck >/dev/null 2>&1 || { echo '[tool-deploy] shellcheck is required but not installed. macOS: brew install shellcheck. Debian/Ubuntu: apt-get install shellcheck.' >&2; exit 1; }",
          "shellcheck -s bash bin/assert-no-prod-release.sh"
        ],
        "parallel": false
      }
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/deploy/k8s/**/*",
      "{workspaceRoot}/tools/tool-devsync/src/bureaucrat-consumer.ts",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
      "!{projectRoot}/tsconfig.spec.json"
    ]
  }
}
