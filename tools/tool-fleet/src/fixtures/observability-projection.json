    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "Prometheus",
      "metadata": {
        "name": "kps-prometheus",
        "namespace": "observability-dev"
      },
      "spec": {
        "automountServiceAccountToken": true,
        "alerting": {
          "alertmanagers": [
            {
              "namespace": "observability-dev",
              "name": "kps-alertmanager",
              "port": "http-web",
              "pathPrefix": "/",
              "apiVersion": "v2"
            }
          ]
        },
        "image": "quay.io/prometheus/prometheus:v3.14.0-distroless@sha256:50c707e96da5ade383cb1707790576480485e93de06aa60ad8802cb5f744bd0a",
        "imagePullPolicy": "IfNotPresent",
        "version": "v3.14.0-distroless",
        "enableRemoteWriteReceiver": true,
        "externalUrl": "http://kps-prometheus.observability-dev:9090",
        "nodeSelector": {
          "puni.dev/capability-observability": "true"
        },
        "paused": false,
        "replicas": 1,
        "shards": 1,
        "logLevel": "info",
        "logFormat": "logfmt",
        "listenLocal": false,
        "enableOTLPReceiver": false,
        "enableAdminAPI": false,
        "resources": {
          "limits": {
            "cpu": "1",
            "memory": "1Gi"
          },
          "requests": {
            "cpu": "200m",
            "memory": "512Mi"
          }
        },
        "retention": "15d",
        "retentionSize": "8GB",
        "tsdb": {
          "outOfOrderTimeWindow": "0s"
        },
        "walCompression": true,
        "routePrefix": "/",
        "serviceAccountName": "kps-prometheus",
        "serviceMonitorSelector": {
          "matchLabels": {
            "puni.dev/telemetry-instance": "dev"
          }
        },
        "serviceMonitorNamespaceSelector": {
          "matchLabels": {
            "kubernetes.io/metadata.name": "observability-dev"
          }
        },
        "podMonitorSelector": {
          "matchLabels": {
            "puni.dev/telemetry-instance": "dev"
          }
        },
        "podMonitorNamespaceSelector": {
          "matchLabels": {
            "kubernetes.io/metadata.name": "observability-dev"
          }
        },
        "probeSelector": {
          "matchLabels": {
            "puni.dev/telemetry-instance": "dev"
          }
        },
        "probeNamespaceSelector": {
          "matchLabels": {
            "kubernetes.io/metadata.name": "observability-dev"
          }
        },
        "securityContext": {
          "fsGroup": 2000,
          "runAsGroup": 2000,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "ruleNamespaceSelector": {
          "matchLabels": {
            "kubernetes.io/metadata.name": "observability-dev"
          }
        },
        "ruleSelector": {
          "matchLabels": {
            "puni.dev/telemetry-instance": "dev"
          }
        },
        "scrapeConfigSelector": {
          "matchLabels": {
            "puni.dev/telemetry-instance": "dev"
          }
        },
        "scrapeConfigNamespaceSelector": {
          "matchLabels": {
            "kubernetes.io/metadata.name": "observability-dev"
          }
        },
        "storage": {
          "volumeClaimTemplate": {
            "spec": {
              "accessModes": ["ReadWriteOnce"],
              "resources": {
                "requests": {
                  "storage": "10Gi"
                }
              },
              "storageClassName": "puni-retain"
            }
          }
        },
        "affinity": {
          "podAntiAffinity": {
            "preferredDuringSchedulingIgnoredDuringExecution": [
              {
                "weight": 100,
                "podAffinityTerm": {
                  "topologyKey": "kubernetes.io/hostname",
                  "labelSelector": {
                    "matchExpressions": [
                      {
                        "key": "app.kubernetes.io/name",
                        "operator": "In",
                        "values": ["prometheus"]
                      },
                      {
                        "key": "app.kubernetes.io/instance",
                        "operator": "In",
                        "values": ["kps-prometheus"]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "portName": "http-web",
        "ignoreNamespaceSelectors": true,
        "hostNetwork": false
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "name": "kps-alertmanager",
        "namespace": "observability-dev"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app": "kube-prometheus-stack-alertmanager",
            "release": "kube-prometheus-stack",
            "self-monitor": "true"
          }
        },
        "namespaceSelector": {
          "matchNames": ["observability-dev"]
        },
        "endpoints": [
          {
            "port": "http-web",
            "enableHttp2": true,
            "path": "/metrics"
          },
          {
            "port": "reloader-web",
            "path": "/metrics"
          }
        ]
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
