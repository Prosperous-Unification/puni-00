{
  "name": "tool-fleet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/tool-fleet/src",
  "projectType": "library",
  "tags": ["scope:infra", "type:scripts", "runtime:bun", "ring:adapter"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/infra/**/*",
      "{workspaceRoot}/deploy/k8s/**/*",
      "{workspaceRoot}/.github/workflows/infra-check.yml",
      "{workspaceRoot}/.github/workflows/deploy-k3s.yml",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
      "!{projectRoot}/tsconfig.spec.json"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --preload ../test/scratch/preload.ts --timeout=30000",
        "cwd": "tools/tool-fleet"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/infra/**/*",
        "{workspaceRoot}/deploy/k8s/**/*",
        "{workspaceRoot}/openspec/changes/observability-environment-parity/evidence/repair-native-control.py",
        "{workspaceRoot}/openspec/changes/observability-environment-parity/evidence/staging-native-control.py",
        "{workspaceRoot}/openspec/changes/observability-environment-parity/evidence/staging-native-prepare-draft.py",
        "{workspaceRoot}/openspec/changes/observability-environment-parity/evidence/staging-native-prepare-bootstrap.py",
        "{workspaceRoot}/openspec/changes/observability-environment-parity/evidence/audit-status-inspection.py",
        "{workspaceRoot}/openspec/changes/observability-environment-parity/audit-status-inspection-proposal.md"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-fleet/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-fleet/src --cache --cache-location .nx/eslintcache-tool-fleet"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force tools/tool-fleet/tsconfig.json"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["test", "lint", "typecheck"],
      "options": {
        "command": "bun tools/tool-fleet/src/check-cli.ts"
      }
    },
    "check:faults": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/check-faults.ts"
      }
    },
    "rehearse:drain": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/drain-rehearsal.ts"
      }
    },
    "rehearse:traefik": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/traefik-rehearsal.ts"
      }
    },
    "lab": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/k3d-lab.ts"
      }
    },
    "plan": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/entrypoint.ts plan"
      }
    },
    "terragrunt-plan": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/entrypoint.ts terragrunt-plan"
      }
    },
    "terragrunt-destroy-plan": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/entrypoint.ts terragrunt-destroy-plan"
      }
    },
    "discover": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/entrypoint.ts discover"
      }
    },
    "apply": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/entrypoint.ts apply"
      }
    },
    "recover": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/recover.ts"
      }
    },
    "health": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/health.ts"
      }
    },
    "maintenance": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/maintenance.ts"
      }
    },
    "synthetic": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/maintenance-workers.ts"
      }
    },
    "controller-image": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/tool-fleet/controller.oci"],
      "options": {
        "command": "bun tools/tool-fleet/src/entrypoint.ts build"
      }
    },
    "object-store-image": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/tool-fleet/object-store.oci"],
      "options": {
        "command": "bun tools/tool-fleet/src/object-store-image-cli.ts"
      }
    },
    "validate-observability-parity": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun tools/tool-fleet/src/observability-parity-cli.ts . \"$PUNI_PARITY_TOOLS\""
      },
      "cache": false
    },
    "observability-preflight": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/observability-preflight-cli.ts"
      }
    },
    "validate-observability-projection": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/observability-projection-cli.ts . \"$PUNI_PARITY_TOOLS\" \"$PUNI_PROJECTION_REQUESTS\""
      }
    },
    "validate-observability-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun tools/tool-fleet/src/observability-source-cli.ts . \"$PUNI_PARITY_TOOLS\" \"$PUNI_SOURCE_REQUESTS\""
      }
    },
    "test:registry-hosts": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        },
        "command": "bun test --preload ./tools/test/scratch/preload.ts ./infra/ansible/tests/registry-hosts.test.ts --timeout=120000"
      }
    },
    "test:registry-storage": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        },
        "command": "bun test ./infra/ansible/tests/registry-storage.test.ts --timeout=120000"
      }
    },
    "test:registry-publication": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        },
        "command": "bun test ./infra/ansible/tests/registry-scratch.test.ts ./infra/ansible/tests/registry-publication.test.ts --timeout=120000"
      }
    },
    "test:registry-capacity": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        },
        "command": "bun test ./infra/ansible/tests/registry-capacity.test.ts --timeout=240000"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun build tools/tool-fleet/src/registry-journal-cli.ts tools/tool-fleet/src/registry-managed-journal-cli.ts tools/tool-fleet/src/registry-flux-reader.ts tools/tool-fleet/src/registry-lifecycle-cli.ts tools/tool-fleet/src/registry-reader-host.ts tools/tool-fleet/src/registry-maintenance-host-cli.ts tools/tool-fleet/src/registry-backup-worker-cli.ts tools/tool-fleet/src/registry-client-worker-cli.ts tools/tool-fleet/src/backup-registry.ts tools/tool-fleet/src/retire-registry.ts tools/tool-fleet/src/recover-registry.ts tools/tool-fleet/src/activate-registry.ts tools/tool-fleet/src/registry-maintenance-status.ts tools/tool-fleet/src/registry-alert-send-cli.ts --target=bun --outdir dist/tool-fleet"
      },
      "outputs": ["{workspaceRoot}/dist/tool-fleet"]
    },
    "rehearse:registry-installer": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 tools/tool-fleet/src/registry-installation.native.py"
      }
    },
    "test:registry-pulls": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        },
        "command": "bun test ./infra/ansible/tests/registry-pulls.test.ts --timeout=180000"
      }
    },
    "rehearse:registry-client-installation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 tools/tool-fleet/src/registry-client-installation-role.native.py"
      }
    }
  }
}
