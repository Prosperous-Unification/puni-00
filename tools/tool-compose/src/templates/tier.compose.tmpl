services:
  {{TIER}}-{{COLOR}}:
    image: {{IMAGE}}
    container_name: {{TIER}}-{{COLOR}}
    restart: unless-stopped
    networks:
      wbs-net:
        aliases:
          - {{TIER}}-{{COLOR}}
    env_file:
      - /srv/wbs/.env
      - /srv/wbs/{{TIER}}.env
    volumes:
      - /srv/wbs/data:/data
