{
  "name": "tool-remote-scripts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/tool-remote-scripts/src",
  "projectType": "library",
  "tags": ["scope:infra", "type:scripts", "runtime:bun", "ring:adapter"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun build tools/tool-remote-scripts/src/swap.ts --target=bun --outfile dist/tool-remote-scripts/swap.js",
          "bun build tools/tool-remote-scripts/src/solver-supervisor.ts --target=bun --outfile dist/tool-remote-scripts/solver-supervisor.js",
          "bun build tools/tool-remote-scripts/src/check-installed-solver.ts --target=bun --outfile dist/tool-remote-scripts/check-installed-solver.js",
          "bun build tools/tool-remote-scripts/src/activate-dependencies.ts --target=bun --outfile dist/tool-remote-scripts/activate-dependencies.js"
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/tool-remote-scripts"]
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/tool-remote-scripts/src/install.ts"
      },
      "cache": false,
      "dependsOn": ["build", "tool-smoke:build"]
    },
    "install-solver-supervisor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/tool-remote-scripts/src/install-solver-supervisor.ts"
      },
      "cache": false,
      "dependsOn": ["build"]
    },
    "materialize-solver-supervisor-config": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/tool-remote-scripts/src/materialize-solver-supervisor-config.ts"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/wbs/be-01/**/*",
        "{workspaceRoot}/apps/wbs/gw-01/src/dependency-capabilities-cli.ts",
        "{workspaceRoot}/apps/wbs/gw-01/src/runtime/dependency-support.ts",
        "{workspaceRoot}/apps/wbs/mcp-01/src/dependency-capabilities-cli.ts",
        "{workspaceRoot}/apps/wbs/mcp-01/src/runtime/dependency-support.ts",
        "{workspaceRoot}/libs/wbs/**/*",
        "{workspaceRoot}/libs/shared/**/*",
        "{workspaceRoot}/apps/wbs/be-01/src/config.ts",
        "{workspaceRoot}/apps/wbs/be-01/src/step-blockage-replay-kinds-cli.ts",
        "{workspaceRoot}/apps/wbs/be-01/src/controller/oidc-options.ts",
        "{workspaceRoot}/apps/wbs/be-01/Dockerfile",
        "{workspaceRoot}/libs/wbs/adapters/observability/src/index.ts",
        "{workspaceRoot}/libs/wbs/adapters/store-sqlite/src/source.ts",
        "{workspaceRoot}/apps/wbs/gw-01/src/config.ts",
        "{workspaceRoot}/apps/wbs/gw-01/src/service/jwt-auth.ts",
        "{workspaceRoot}/apps/wbs/gw-01/Dockerfile",
        "{workspaceRoot}/libs/wbs/adapters/auth/src/*.ts",
        "!{workspaceRoot}/libs/wbs/adapters/auth/src/*.test.ts",
        "{workspaceRoot}/libs/wbs/adapters/config/src/*.ts",
        "!{workspaceRoot}/libs/wbs/adapters/config/src/*.test.ts",
        "{workspaceRoot}/libs/wbs/domain/validation/src/*.ts",
        "!{workspaceRoot}/libs/wbs/domain/validation/src/*.test.ts",
        "{workspaceRoot}/deploy/compose/site-dev.caddy.candidate",
        "{workspaceRoot}/docs/runbook-dev-deploy.md"
      ],
      "options": {
        "command": "bun test src --preload ../test/scratch/preload.ts --timeout=10000",
        "cwd": "tools/tool-remote-scripts"
      },
      "dependsOn": ["test:caddy"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-remote-scripts/src tools/tool-remote-scripts/caddy tools/tool-remote-scripts/test"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint tools/tool-remote-scripts/src tools/tool-remote-scripts/caddy tools/tool-remote-scripts/test --cache --cache-location .nx/eslintcache-tool-remote-scripts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force tools/tool-remote-scripts/tsconfig.json"
      }
    },
    "test:caddy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun run tools/tool-remote-scripts/caddy/run.ts"
      }
    },
    "test:backend-recreation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun run tools/tool-remote-scripts/test/backend-recreation.ts"
      }
    },
    "check-installed-solver": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run tools/tool-remote-scripts/src/check-installed-solver.ts"
      },
      "cache": false
    },
    "test:gateway-exclusion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun run tools/tool-remote-scripts/test/gateway-exclusion.ts"
      }
    },
    "test:backend-exclusion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun run tools/tool-remote-scripts/test/backend-exclusion.ts"
      }
    },
    "inspect-installed-writers": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun run tools/tool-remote-scripts/src/inspect-installed-writers.ts"
      }
    },
    "test:dependency-ingress": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun run tools/tool-remote-scripts/test/dependency-ingress.ts"
      }
    },
    "test:solver-drain": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun run tools/tool-remote-scripts/test/solver-drain.ts"
      }
    }
  }
}
