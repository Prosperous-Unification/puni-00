{
  "name": "workspace-portability",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/workspace",
  "projectType": "library",
  "tags": ["scope:infra", "type:scripts", "runtime:bun", "ring:adapter"],
  "targets": {
    "test": {
      "command": "bun test tools/workspace/portability.test.ts"
    },
    "lint": {
      "command": "bunx eslint tools/workspace && bunx prettier --check tools/workspace"
    },
    "typecheck": {
      "command": "bunx tsc -p tools/workspace/tsconfig.json"
    },
    "build": {
      "command": "bun build tools/workspace/portability.ts --target=bun --outdir=dist/tools/workspace"
    }
  }
}
