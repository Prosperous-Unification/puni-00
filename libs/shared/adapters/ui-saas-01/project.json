  "projectType": "library",
  "tags": ["scope:shared", "type:ui", "runtime:browser", "ring:adapter", "product:shared"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/shared/adapters/ui-saas-01/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/shared/adapters/ui-saas-01/src --cache --cache-location .nx/eslintcache-shared-ui-saas-01"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/shared/adapters/ui-saas-01"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/shared/adapters/ui-saas-01"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/shared/adapters/ui-saas-01/tsconfig.json"
      }
    }
  }
