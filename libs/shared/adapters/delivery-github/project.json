{
  "name": "shared-delivery-github",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/adapters/delivery-github/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:adapter", "runtime:isomorphic", "ring:adapter", "product:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/shared/adapters/delivery-github/tsconfig.lib.json"
      },
      "outputs": ["{workspaceRoot}/dist/out-tsc"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx eslint libs/shared/adapters/delivery-github/src" }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/shared/adapters/delivery-github/src --cache --cache-location .nx/eslintcache-shared-delivery-github"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/shared/adapters/delivery-github"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/shared/adapters/delivery-github"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit:level": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^production"],
      "options": {
        "command": "mkdir -p ../../../../tmp/junit && rm -f ../../../../tmp/junit/shared-delivery-github.unit.xml && files=$(find ./src -name '*.test.ts' ! -name '*.db.test.ts') && if [ -z \"$files\" ]; then echo 'no-cases: shared-delivery-github:test:unit:level' >&2; exit 1; fi && bun test $files --reporter=junit --reporter-outfile=../../../../tmp/junit/shared-delivery-github.unit.xml --timeout=10000",
        "cwd": "libs/shared/adapters/delivery-github",
        "env": { "CLAUDECODE": "0", "AGENT": "0" },
        "forwardAllArgs": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/shared/adapters/delivery-github/tsconfig.json"
      }
    }
  }
}
