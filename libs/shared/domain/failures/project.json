{
  "name": "shared-failures",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/domain/failures/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:failures", "runtime:isomorphic", "ring:domain", "product:shared"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/shared/domain/failures/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/shared/domain/failures/src --cache --cache-location .nx/eslintcache-shared-failures"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/shared/domain/failures"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/shared/domain/failures"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/shared/domain/failures/tsconfig.json"
      }
    },
    "test:unit:level": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^production"],
      "options": {
        "command": "mkdir -p ../../../../tmp/junit && rm -f ../../../../tmp/junit/shared-failures.unit.xml && files=$(find ./src -name '*.test.ts' ! -name '*.db.test.ts') && if [ -z \"$files\" ]; then echo 'no-cases: shared-failures:test:unit:level' >&2; exit 1; fi && bun test $files --reporter=junit --reporter-outfile=../../../../tmp/junit/shared-failures.unit.xml --timeout=10000",
        "cwd": "libs/shared/domain/failures",
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        },
        "forwardAllArgs": false
      }
    }
  }
}
