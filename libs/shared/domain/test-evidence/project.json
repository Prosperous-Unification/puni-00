{
  "name": "shared-test-evidence",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/domain/test-evidence/src",
  "projectType": "library",
  "tags": ["scope:shared", "ring:domain", "runtime:isomorphic", "product:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/shared/domain/test-evidence/tsconfig.lib.json"
      },
      "outputs": ["{workspaceRoot}/dist/out-tsc"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx eslint libs/shared/domain/test-evidence/src" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test src --timeout=10000",
        "cwd": "libs/shared/domain/test-evidence"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/shared/domain/test-evidence/tsconfig.json"
      }
    }
  }
}
