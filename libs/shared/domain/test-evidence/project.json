{
  "name": "shared-test-evidence",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/domain/test-evidence/src",
  "projectType": "library",
  "tags": ["scope:shared", "ring:domain", "runtime:isomorphic", "product:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/shared/domain/test-evidence/tsconfig.lib.json"
      },
      "outputs": ["{workspaceRoot}/dist/out-tsc"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx eslint libs/shared/domain/test-evidence/src" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test src --timeout=10000",
        "cwd": "libs/shared/domain/test-evidence"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test src --timeout=10000",
        "cwd": "libs/shared/domain/test-evidence"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/shared/domain/test-evidence/tsconfig.json"
      }
    },
    "test:unit:level": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^production"],
      "options": {
        "command": "mkdir -p ../../../../tmp/junit && rm -f ../../../../tmp/junit/shared-test-evidence.unit.xml && files=$(find ./src -name '*.test.ts' ! -name '*.db.test.ts') && if [ -z \"$files\" ]; then echo 'no-cases: shared-test-evidence:test:unit:level' >&2; exit 1; fi && bun test $files --reporter=junit --reporter-outfile=../../../../tmp/junit/shared-test-evidence.unit.xml --timeout=10000",
        "cwd": "libs/shared/domain/test-evidence",
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        },
        "forwardAllArgs": false
      }
    }
  }
}
