{
  "name": "store-memory",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/store-memory/src",
  "projectType": "library",
  "tags": ["scope:shared", "ring:adapter", "runtime:isomorphic", "product:wbs"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx eslint libs/store-memory/src" }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/store-memory/src --cache --cache-location .nx/eslintcache-store-memory"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/be-01/src/testing/in-memory-source.test.ts",
        "{workspaceRoot}/apps/be-01/src/testing/in-memory-source.ts",
        "{workspaceRoot}/apps/be-01/src/testing/project-fixture.ts",
        "{workspaceRoot}/apps/be-01/src/testing/kits/source-conformance.ts",
        "{workspaceRoot}/apps/be-01/src/testing/kits/unit-of-work-conformance.ts",
        "{workspaceRoot}/libs/store-sqlite/src/testing/source-conformance.ts",
        "{workspaceRoot}/libs/store-sqlite/src/testing/unit-of-work-conformance.ts"
      ],
      "options": {
        "command": "bun test src ../../apps/be-01/src/testing/in-memory-source.test.ts --coverage --coverage-reporter=lcov",
        "cwd": "libs/store-memory"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx tsc --build --force libs/store-memory/tsconfig.json" }
    }
  }
}
