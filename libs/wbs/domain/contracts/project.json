{
  "name": "wbs-contracts",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/wbs/domain/contracts/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:contracts", "runtime:isomorphic", "ring:domain", "product:wbs"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/domain/contracts/src libs/wbs/domain/contracts/solver/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/domain/contracts/src libs/wbs/domain/contracts/solver/src --cache --cache-location .nx/eslintcache-wbs-contracts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find src solver/src -name '*.test.ts' -o -name '*.test.tsx' | sort) --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/wbs/domain/contracts"
      },
      "outputs": ["{projectRoot}/coverage"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/mcp/testing/pool-keys.v1.json"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find src solver/src -name '*.test.ts' -o -name '*.test.tsx' | sort) --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/wbs/domain/contracts"
      },
      "outputs": ["{projectRoot}/coverage"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/mcp/testing/pool-keys.v1.json"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/wbs/domain/contracts/tsconfig.json"
      }
    }
  }
}
