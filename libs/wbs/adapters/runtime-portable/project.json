{
  "name": "wbs-runtime-portable",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/wbs/adapters/runtime-portable/src",
  "projectType": "library",
  "tags": ["scope:shared", "ring:adapter", "runtime:isomorphic", "product:wbs"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/adapters/runtime-portable/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/adapters/runtime-portable/src --cache --cache-location .nx/eslintcache-wbs-runtime-portable"
      }
    },
    "test:unit:level": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^production"],
      "options": {
        "command": "mkdir -p ../../../../tmp/junit && rm -f ../../../../tmp/junit/wbs-runtime-portable.unit.xml && files=$(find . ! -path . -name '.*' -prune -o -type d -name node_modules -prune -o -type d -name dist -prune -o -type d -name coverage -prune -o -type d -name test-results -prune -o -type f -name '*.test.ts' ! -name '*.db.test.ts' -print) && if [ -z \"$files\" ]; then echo 'no-cases: wbs-runtime-portable:test:unit:level' >&2; exit 1; fi && bun test $files --reporter=junit --reporter-outfile=../../../../tmp/junit/wbs-runtime-portable.unit.xml --timeout=10000",
        "cwd": "libs/wbs/adapters/runtime-portable",
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        },
        "forwardAllArgs": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/wbs/adapters/runtime-portable"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/wbs/adapters/runtime-portable"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/wbs/adapters/runtime-portable/tsconfig.json"
      }
    }
  }
}
