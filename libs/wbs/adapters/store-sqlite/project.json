{
  "name": "wbs-store-sqlite",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/wbs/adapters/store-sqlite/src",
  "projectType": "library",
  "tags": ["scope:shared", "ring:adapter", "runtime:bun", "product:wbs"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/adapters/store-sqlite/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/adapters/store-sqlite/src --cache --cache-location .nx/eslintcache-wbs-store-sqlite"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/wbs/be-01/drizzle",
        "{workspaceRoot}/apps/wbs/be-01/src/testing/saved-plan-lock-holder.ts",
        "{workspaceRoot}/apps/wbs/be-01/src/shared-people-rollback-cli.ts",
        "{workspaceRoot}/openspec/changes/dual-optimized-scheduler/design.md"
      ],
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=30000",
        "cwd": "libs/wbs/adapters/store-sqlite"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:api": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/wbs/be-01/drizzle",
        "{workspaceRoot}/apps/wbs/be-01/src/shared-people-rollback-cli.ts"
      ],
      "options": {
        "command": "mkdir -p ../../../../tmp/junit && bun test $(find src -name '*.db.test.ts' ! -name 'source-conformance.db.test.ts' | tr '\\n' ' ') --reporter=junit --reporter-outfile=../../../../tmp/junit/wbs-store-sqlite.api.xml --timeout=30000",
        "cwd": "libs/wbs/adapters/store-sqlite",
        "forwardAllArgs": false
      }
    },
    "test:conformance": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^production", "{workspaceRoot}/apps/wbs/be-01/drizzle"],
      "options": {
        "command": "bun test src/testing/source-conformance.db.test.ts --timeout=30000",
        "cwd": "libs/wbs/adapters/store-sqlite",
        "forwardAllArgs": false
      }
    },
    "test:conformance:level": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^production", "{workspaceRoot}/apps/wbs/be-01/drizzle"],
      "options": {
        "command": "mkdir -p ../../../../tmp/junit && rm -f ../../../../tmp/junit/wbs-store-sqlite.conformance.xml && files=$(find src/testing -name 'source-conformance.db.test.ts') && if [ -z \"$files\" ]; then echo 'no-cases: wbs-store-sqlite:test:conformance:level' >&2; exit 1; fi && bun test $files --reporter=junit --reporter-outfile=../../../../tmp/junit/wbs-store-sqlite.conformance.xml --timeout=30000",
        "cwd": "libs/wbs/adapters/store-sqlite",
        "forwardAllArgs": false
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production", "{workspaceRoot}/apps/wbs/be-01/drizzle"],
      "options": {
        "command": "mkdir -p ../../../../tmp/junit && bun test $(find src -name '*.test.ts' ! -name '*.db.test.ts' | tr '\\n' ' ') --coverage --coverage-reporter=lcov --reporter=junit --reporter-outfile=../../../../tmp/junit/wbs-store-sqlite.unit.xml --timeout=30000",
        "cwd": "libs/wbs/adapters/store-sqlite"
      },
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/wbs/adapters/store-sqlite/tsconfig.json"
      }
    }
  }
}
