{
  "name": "wbs-observability",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/wbs/adapters/observability/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:observability", "ring:adapter", "runtime:bun", "product:wbs"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/adapters/observability/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint libs/wbs/adapters/observability/src --cache --cache-location .nx/eslintcache-wbs-observability"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/wbs/adapters/observability"
      },
      "outputs": ["{projectRoot}/coverage"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/infra/platform/observability/otel/collector.yaml",
        "{workspaceRoot}/infra/platform/observability/elastic/settings/failure-fields.json"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "libs/wbs/adapters/observability"
      },
      "outputs": ["{projectRoot}/coverage"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/infra/platform/observability/otel/collector.yaml",
        "{workspaceRoot}/infra/platform/observability/elastic/settings/failure-fields.json"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force libs/wbs/adapters/observability/tsconfig.json"
      }
    }
  }
}
