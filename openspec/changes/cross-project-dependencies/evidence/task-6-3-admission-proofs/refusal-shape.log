"object\",\"description\":\"Change fields of a work item; only the fields named change. typeIds and typeRefs together name at most one type (a list of zero clears it); more is refused with work_item_takes_one_type.\",\"properties\":{\"kind\":{\"const\":\"patchWorkItem\"},\"patch\":{\"type\":\"object\",\"properties\":{\"deadline\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"externalRefs\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"systemId\":{\"type\":\"string\"},\"url\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"systemId\",\"url\"],\"additionalProperties\":false}},\"factEnd\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"factStart\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"maxParallel\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"name\":{\"type\":\"string\"},\"notes\":{\"type\":\"string\"},\"priority\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"serviceIds\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"serviceRefs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"serviceTeamId\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"startNoEarlierThan\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"startNoEarlierThanReason\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"tagIds\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"tagRefs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"teamIds\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"teamRefs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"typeIds\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"typeRefs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"additionalProperties\":false},\"workItemId\":{\"type\":\"string\"},\"workItemRef\":{\"type\":\"string\"}},\"required\":[\"kind\",\"patch\"],\"additionalProperties\":false},{\"type\":\"object\",\"description\":\"Rename a work item type.\",\"properties\":{\"kind\":{\"const\":\"patchWorkItemType\"},\"name\":{\"type\":\"string\"},\"typeId\":{\"type\":\"string\"},\"typeRef\":{\"type\":\"string\"}},\"required\":[\"kind\",\"name\"],\"additionalProperties\":false},{\"type\":\"object\",\"description\":\"Release a person’s claims: on a leaf the named steps or every step; on a non-leaf the subtree claim and every claim delegated under it. Progress is untouched. Refused not_claimed_by when the person holds none, and person_not_bound or credential_not_for_person as for claimWorkItem.\",\"properties\":{\"kind\":{\"const\":\"releaseWorkItem\"},\"personId\":{\"type\":\"string\"},\"personRef\":{\"type\":\"string\"},\"steps\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"workItemId\":{\"type\":\"string\"},\"workItemRef\":{\"type\":\"string\"}},\"required\":[\"kind\"],\"additionalProperties\":false},{\"type\":\"object\",\"description\":\"Stop a work item waiting for another.\",\"properties\":{\"kind\":{\"const\":\"removeDependency\"},\"predecessorId\":{\"type\":\"string\"},\"predecessorRef\":{\"type\":\"string\"},\"workItemId\":{\"type\":\"string\"},\"workItemRef\":{\"type\":\"string\"}},\"required\":[\"kind\"],\"additionalProperties\":false},{\"type\":\"object\",\"description\":\"Name who does one step of a work item, or null to unassign. Accepts stepNodeId in place of the work-item and step pair.\",\"properties\":{\"kind\":{\"const\":\"setAssignee\"},\"personId\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"personRef\":{\"type\":\"string\"},\"stepId\":{\"type\":\"string\"},\"stepNodeId\":{\"type\":\"string\"},\"workItemId\":{\"type\":\"string\"},\"workItemRef\":{\"type\":\"string\"}},\"required\":[\"kind\"],\"additionalProperties\":false},{\"type\":\"object\",\"description\":\"How many of a team may be at work at once on this project; null means unstated.\",\"properties\":{\"kind\":{\"const\":\"setCapacity\"},\"size\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"teamId\":{\"type\":\"string\"},\