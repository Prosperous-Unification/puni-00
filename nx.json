{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/**/*.stories.[jt]s?(x)",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/vitest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.js",
      "{workspaceRoot}/.prettierrc.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/tools/test/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/tool-devsync/product-policies.mjs",
        "{workspaceRoot}/tools/tool-devsync/workspace-projects.mjs",
        "{workspaceRoot}/apps/*/eslint.product.mjs",
        "{workspaceRoot}/apps/*/*/eslint.product.mjs",
        "{workspaceRoot}/libs/*/eslint.product.mjs",
        "{workspaceRoot}/apps/**/project.json",
        "{workspaceRoot}/libs/**/project.json",
        "{workspaceRoot}/tools/**/project.json",
        "{workspaceRoot}/.prettierrc.json"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.base.json"]
    },
    "deploy": {
      "cache": false
    },
    "push": {
      "cache": false
    },
    "decrypt": {
      "cache": false
    },
    "test:unit": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "test:api": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "test:conformance": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "test:store": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "test:portable": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "test:package": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "integration": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "e2e": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "e2e-packaged": {
      "options": {
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    }
  },
  "plugins": [],
  "defaultBase": "main",
  "parallel": 4,
  "useInferencePlugins": false,
  "analytics": false
}
