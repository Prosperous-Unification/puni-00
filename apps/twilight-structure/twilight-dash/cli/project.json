{
  "name": "twilight-dash",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/twilight-structure/twilight-dash/cli/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun", "ring:adapter", "product:twilight-dash"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --preload ../../../../tools/test/scratch/preload.ts src --timeout=60000",
        "cwd": "apps/twilight-structure/twilight-dash/cli"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.github/workflows/trusted-wiki.yml",
        "{workspaceRoot}/apps/twilight-structure/twilight-burokrat/cli/**/*"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/twilight-structure/twilight-dash/cli/src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/twilight-structure/twilight-dash/cli/tsconfig.json"
      }
    }
  }
}
