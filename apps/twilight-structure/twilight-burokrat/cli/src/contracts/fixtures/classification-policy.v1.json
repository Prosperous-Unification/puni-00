      "exclude": []
    },
    {
      "contentClass": "openspec",
      "include": [
        {
          "kind": "prefix",
          "value": "openspec"
        }
      ],
      "exclude": []
    },
    {
      "contentClass": "placeholder",
      "include": [
        {
          "kind": "name",
          "value": ".gitkeep"
        },
        {
          "kind": "name",
          "value": ".keep"
        }
      ],
      "exclude": []
