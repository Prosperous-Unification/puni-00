    {
      "contentClass": "document",
      "include": [
        {
          "kind": "suffix",
          "value": ".md"
        },
        {
          "kind": "suffix",
          "value": ".txt"
        }
      ],
      "exclude": [
        {
          "kind": "prefix",
          "value": "openspec"
        },
        {
          "kind": "segment",
          "value": "fixtures"
        }
      ]
