{
  "schemaVersion": 1,
  "policyId": "classification.baseline.v1",
  "selectorVersion": 1,
  "contentClasses": [
    "source",
    "test",
    "config",
    "script",
    "migration",
    "fixture",
    "generated",
    "vendored",
    "placeholder",
    "document",
    "openspec"
  ],
  "contentRules": [
    {
      "contentClass": "test",
      "include": [
        {
          "kind": "suffix",
          "value": ".test.ts"
        },
        {
          "kind": "suffix",
          "value": ".spec.ts"
        },
        {
          "kind": "suffix",
          "value": ".test.tsx"
        },
        {
          "kind": "suffix",
          "value": ".spec.tsx"
        },
        {
          "kind": "suffix",
          "value": ".test.sh"
        },
        {
          "kind": "segment",
          "value": "e2e"
        },
        {
          "kind": "segment",
          "value": "test"
        },
        {
          "kind": "segment",
          "value": "tests"
        }
      ],
      "exclude": []
    },
    {
      "contentClass": "generated",
      "include": [
        {
          "kind": "segment",
          "value": "generated"
        }
      ],
      "exclude": []
