{
  "name": "wbs-be-01",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wbs/be-01/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun", "ring:adapter", "product:wbs"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch src/main.ts",
        "cwd": "apps/wbs/be-01"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun build apps/wbs/be-01/src/main.ts --target=bun --outdir=dist/apps/wbs/be-01",
          "mkdir -p dist/apps/wbs/be-01/public-email-policy && cp libs/wbs/domain/domain/src/public-email-policy.v1.json libs/wbs/domain/domain/src/public-email-policy.manifest.json dist/apps/wbs/be-01/public-email-policy/",
          "bun apps/wbs/be-01/src/openapi/emit-openapi-cli.ts dist/apps/wbs/be-01/openapi.json"
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/apps/wbs/be-01"],
      "dependsOn": ["^build", "build-host-restore"]
    },
    "solver-image-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "shellcheck -s bash apps/wbs/be-01/scripts/solver-image-smoke.sh && bash apps/wbs/be-01/scripts/solver-image-smoke.sh"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/wbs/be-01/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/wbs/be-01/src --cache --cache-location .nx/eslintcache-wbs-be-01"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/libs/wbs/domain/domain/src/schedule.ts",
        "{workspaceRoot}/openspec/changes/dual-optimized-scheduler/design.md",
        "{workspaceRoot}/tools/tool-remote-scripts/src/fixtures/solver-supervisor-orphan-host.ts",
        "{workspaceRoot}/apps/wbs/gw-01/src/**/*",
        "{workspaceRoot}/apps/wbs/fe-01/src/**/*",
        "{workspaceRoot}/apps/wbs/fe-01/tsconfig.app.json",
        "{workspaceRoot}/apps/wbs/fe-01/tsconfig.json",
        "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/runs/**/*",
        "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/bridge/**/*",
        "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/agents/**/*",
        "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/clock.ts",
        "{workspaceRoot}/apps/twilight-structure/twilight-burokrat/cli/src/contracts/**/*",
        "mcpAgentRuntime"
      ],
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "apps/wbs/be-01"
      },
      "outputs": ["{projectRoot}/coverage"],
      "dependsOn": ["prepare-mcp-document"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find src -name '*.test.ts' ! -name '*.db.test.ts' | tr '\\n' ' ') --timeout=10000",
        "cwd": "apps/wbs/be-01"
      },
      "dependsOn": ["prepare-mcp-document"],
      "inputs": ["default", "^production", "mcpAgentRuntime"]
    },
    "test:store": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test .db.test.ts --timeout=10000",
        "cwd": "apps/wbs/be-01"
      },
      "dependsOn": ["prepare-mcp-document"],
      "inputs": ["default", "^production", "mcpAgentRuntime"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/wbs/be-01/tsconfig.json"
      },
      "dependsOn": ["typecheck:module"]
    },
    "serve-local-solver": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch src/dev/main.ts",
        "cwd": "apps/wbs/be-01"
      },
      "cache": false
    },
    "typecheck:module": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun tools/tool-devsync/src/typecheck-modules.ts apps/wbs/be-01/src/module"
      }
    },
    "build-host-restore": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun build apps/wbs/be-01/src/shared-people-host-restore-cli.ts --target=bun --outfile=dist/apps/wbs/be-01-host/shared-people-host-restore.js"
      },
      "outputs": ["{workspaceRoot}/dist/apps/wbs/be-01-host"]
    },
    "test:host-restore": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-host-restore"],
      "options": {
        "command": "bun test ./apps/wbs/be-01/scripts/shared-people-host-artifact.smoke.ts ./apps/wbs/be-01/scripts/shared-people-host-restore.rehearsal.ts --timeout=60000",
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "acceptance:historical-plan-reader": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun test ./apps/wbs/be-01/scripts/historical-plan-reader.acceptance.ts --timeout=60000",
        "env": {
          "CLAUDECODE": "0",
          "AGENT": "0"
        }
      }
    },
    "prepare-mcp-document": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["mcpAgentRuntime", "^production"],
      "options": {
        "command": "bun apps/wbs/be-01/src/openapi/emit-openapi-cli.ts apps/wbs/mcp-01/src/openapi.json"
      },
      "outputs": ["{workspaceRoot}/apps/wbs/mcp-01/src/openapi.json"]
    }
  },
  "namedInputs": {
    "mcpAgentRuntime": [
      "{projectRoot}/src/openapi/emit-openapi-cli.ts",
      "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/clock.ts",
      "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/compute/configuration.ts",
      "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/compute/provider.ts",
      "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/entrypoint.ts",
      "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/mcp/machine-token.ts",
      "{workspaceRoot}/apps/twilight-structure/twilight-dash/cli/src/mcp/token-command.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/drizzle/20260921090000_mcp_refresh_family/down.sql",
      "{workspaceRoot}/apps/wbs/mcp-01/drizzle/20260921090000_mcp_refresh_family/migration.sql",
      "{workspaceRoot}/apps/wbs/mcp-01/drizzle/20260927120000_mcp_credential_binding/down.sql",
      "{workspaceRoot}/apps/wbs/mcp-01/drizzle/20260927120000_mcp_credential_binding/migration.sql",
      "{workspaceRoot}/apps/wbs/mcp-01/drizzle/20261021120000_mcp_client/down.sql",
      "{workspaceRoot}/apps/wbs/mcp-01/drizzle/20261021120000_mcp_client/migration.sql",
      "{workspaceRoot}/apps/wbs/mcp-01/drizzle/20261022130000_mcp_family_person/down.sql",
      "{workspaceRoot}/apps/wbs/mcp-01/drizzle/20261022130000_mcp_family_person/migration.sql",
      "{workspaceRoot}/apps/wbs/mcp-01/src/caller-auth.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/config.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/deployment-fault.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/http.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/in-flight-counter.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/load/mcp-01-loopback.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/machine-admission.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/machine-grant-client.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/machine-limits.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/main.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/oauth.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/openapi-tools.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/organization-authority.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/pending-authorizations.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/refresh-authority.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/server.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/session-store.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/source-address.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/store-migrations.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/token-bucket.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/token-request.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/unexpected-tool-failure.ts",
      "{workspaceRoot}/apps/wbs/mcp-01/src/wbs-client.ts"
    ]
  }
}
