NODE_ENV=development
AUTH_MODE=local
# Required, no default: `enabled` commits logout, refresh and credential
# replacement through the shared durable browser lifecycle and reads the browser
# organization cookie; `disabled` keeps the legacy browser routes.
BROWSER_SESSION_AUTHORITY=disabled
APP_ORIGIN=http://localhost:4200
PORT=3100
LOG_LEVEL=info
INTERNAL_AUTH_SECRET=local-dev-internal-auth-secret-32ch
GW_URL=http://localhost:3200
DB_PATH=./local.db
VERSION=local
# One budget shared by both optimized variants. Omit to use the 60000ms default.
SOLVER_BUDGET_MS=60000
# CP-SAT search workers per child. At the fleet ceiling, 16 x 2 = 32 workers.
SOLVER_SEARCH_WORKERS=2
# RSS authority is the external child scope; RLIMIT_AS is a looser backstop.
SOLVER_MEMORY_LIMIT_MB=512
# The caller id be-01 names itself by to the solver supervisor. Required: be-01
# refuses to boot without it. A deployed container's is its Docker hostname; on
# a workstation there is no supervisor socket, so optimization reports itself
# unavailable and this placeholder in the 12-hex hostname shape is never
# matched against a peer. An exported shell HOSTNAME takes precedence.
HOSTNAME=000000000000
# Deployed containers must NOT migrate on boot (design decision 8) — the
# deploy pipeline runs migrations as its own discrete step instead. Local
# dev has no blue/green overlap to protect, so it opts back in to the old
# one-process convenience here. Leave this unset/false anywhere else.
MIGRATE_ON_STARTUP=true
# Signs the tokens gw-01 verifies on the WebSocket. Must be byte-identical to
# gw-01's JWT_SIGNING_KEY_CURRENT or login works and the socket 401s -- which is
# exactly what these two files shipped for a day, the comment stating the rule
# while the value below broke it. `tools/dev/setup.test.ts` now compares them.
JWT_SIGNING_KEY_CURRENT=local-dev-jwt-signing-key-32chrs!!
