MCP_AUTH_MODE=standalone
WBS_API_URL=https://dev.wbs.bulletpoints.club
MCP_PUBLIC_URL=https://dev.wbs.bulletpoints.club/mcp
# Generate an RSA PKCS8 key and store its DER bytes as base64. Previous is optional during rotation.
MCP_SIGNING_KEY_CURRENT=replace-with-base64-pkcs8
# MCP_SIGNING_KEY_PREVIOUS=
# Generate 32 random bytes and store them as base64. Previous is optional during rotation.
MCP_STORE_KEY_CURRENT=replace-with-32-byte-base64
# MCP_STORE_KEY_PREVIOUS=
# Dev deployment must set this to /data/mcp-session.sqlite in its host-managed .env.
MCP_STORE_PATH=./mcp-session.sqlite
# Seconds. One hour is conservative until the live client refresh check is complete.
MCP_ACCESS_TOKEN_TTL=3600
PORT=3300
AUTH_ISSUER_DISCOVERY_URL=https://idp.example/oauth2/default
AUTH_AUDIENCE=api://wbs
AUTH_CLIENT_ID=wbs
AUTH_CLIENT_SECRET=replace-me
# AUTH_GROUPS_CLAIM=wbs_groups
# be-01's INTERNAL_AUTH_SECRET: binds consents to an organization after activation
# and calls be-01 with signed delegations (docs/auth-integration.md).
# INTERNAL_AUTH_SECRET=
# be-01's MCP_BE_INTERNAL_SECRET, sent as x-mcp-internal-auth on machine grant requests,
# on every machine token's be-01 call, and, in place of INTERNAL_AUTH_SECRET, on every
# /internal/mcp/* call (wbs-mcp-agent-surface M14). Set, the token endpoint offers
# client_credentials and the JWT-bearer grant; unset, it answers both unsupported_grant_type.
# MCP_BE_INTERNAL_SECRET=
# Seconds a machine access token asks for, 60 to 86400, lowered by a 0-10% jitter.
# MCP_MACHINE_TOKEN_TTL=43200
# Gateway mode only: MCP_TRUSTED_GATEWAY=true
