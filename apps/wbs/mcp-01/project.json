{
  "name": "wbs-mcp-01",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wbs/mcp-01/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun", "ring:adapter", "product:wbs"],
  "implicitDependencies": ["wbs-be-01"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch src/main.ts",
        "cwd": "apps/wbs/mcp-01"
      },
      "cache": false,
      "dependsOn": ["prepare"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun build apps/wbs/mcp-01/src/main.ts --target=bun --outdir=dist/apps/wbs/mcp-01",
          "bun apps/wbs/be-01/src/openapi/emit-openapi-cli.ts dist/apps/wbs/mcp-01/openapi.json"
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/apps/wbs/mcp-01"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/wbs/mcp-01/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/wbs/mcp-01/src --cache --cache-location .nx/eslintcache-wbs-mcp-01"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --coverage --coverage-reporter=lcov --timeout=10000",
        "cwd": "apps/wbs/mcp-01"
      },
      "outputs": ["{projectRoot}/coverage"],
      "dependsOn": ["prepare"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/wbs/mcp-01/tsconfig.json"
      }
    },
    "serve-local-solver": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch src/main.ts",
        "cwd": "apps/wbs/mcp-01"
      },
      "cache": false,
      "dependsOn": ["prepare"]
    },
    "prepare": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun apps/wbs/be-01/src/openapi/emit-openapi-cli.ts apps/wbs/mcp-01/src/openapi.json"
      },
      "outputs": ["{projectRoot}/src/openapi.json"],
      "cache": false
    }
  }
}
