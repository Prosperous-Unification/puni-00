{
  "name": "twilight-bureaucrat",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wiki/cli/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun", "ring:adapter", "product:twilight-bureaucrat"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/.github/workflows/trusted-wiki.yml",
        "{workspaceRoot}/.github/workflows/twilight-bureaucrat-release.yml",
        "{workspaceRoot}/apps/wiki/consumer/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/NOTICE"
      ],
      "options": {
        "command": "TOOL_WIKI_TRUSTED_NODE_MODULES=$PWD/../../../node_modules bun test --path-ignore-patterns '**/packaging/install.test.ts' --preload ../../../tools/test/scratch/preload.ts",
        "cwd": "apps/wiki/cli"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["{workspaceRoot}/**/*"],
      "options": {
        "command": "bash bin/tool-wiki-lint.sh working . HEAD"
      }
    },
    "lint:source": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bunx eslint apps/wiki/cli/src"
      }
    },
    "lint:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/wiki/cli/src --cache --cache-location .nx/eslintcache-twilight-bureaucrat"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun src/packaging/release-cli.ts",
        "cwd": "apps/wiki/cli"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/README.md",
        "{projectRoot}/NOTICE",
        "{workspaceRoot}/libs/shared/domain/validation/src/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/.bun-version"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "bun src/packaging/build.ts",
        "cwd": "apps/wiki/cli"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/twilight-bureaucrat-pack"],
      "options": {
        "command": "bun src/packaging/pack.ts",
        "cwd": "apps/wiki/cli"
      }
    },
    "test:package": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["pack"],
      "options": {
        "command": "TOOL_WIKI_TRUSTED_NODE_MODULES=$PWD/../../../node_modules bun test --preload ../../../tools/test/scratch/preload.ts src/packaging",
        "cwd": "apps/wiki/cli"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/wiki/cli/tsconfig.json"
      }
    }
  }
}
