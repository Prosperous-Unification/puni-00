{
  "name": "fe-01",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fe-01/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:browser"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "bunx vite", "cwd": "apps/fe-01" },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx vite build", "cwd": "apps/fe-01" },
      "outputs": ["{workspaceRoot}/dist/apps/fe-01"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx vitest run", "cwd": "apps/fe-01" }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun run tools/dev/setup.ts",
          "bunx playwright test --config apps/fe-01/playwright.config.ts"
        ],
        "parallel": false
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/fe-01/src apps/fe-01/e2e apps/fe-01/playwright.config.ts apps/fe-01/vite.config.ts apps/fe-01/vitest.config.ts apps/fe-01/vite-config.test.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx tsc --build --force apps/fe-01/tsconfig.app.json",
          "bunx tsc --build --force apps/fe-01/tsconfig.e2e.json"
        ],
        "parallel": false
      }
    }
  }
}
