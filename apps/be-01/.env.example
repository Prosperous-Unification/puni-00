PORT=3100
LOG_LEVEL=info
INTERNAL_AUTH_SECRET=local-dev-internal-auth-secret-32ch
GW_URL=http://localhost:3200
DB_PATH=./local.db
VERSION=local
# Deployed containers must NOT migrate on boot (design decision 8) — the
# deploy pipeline runs migrations as its own discrete step instead. Local
# dev has no blue/green overlap to protect, so it opts back in to the old
# one-process convenience here. Leave this unset/false anywhere else.
MIGRATE_ON_STARTUP=true
