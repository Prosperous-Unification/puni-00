{
  "name": "puni-cli",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/puni/cli/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun", "ring:adapter", "product:puni"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test --preload ../../../tools/test/scratch/preload.ts src --timeout=30000",
        "cwd": "apps/puni/cli"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx eslint apps/puni/cli/src" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "bunx tsc --build --force apps/puni/cli/tsconfig.json" }
    }
  }
}
