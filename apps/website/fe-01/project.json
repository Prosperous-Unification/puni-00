{
  "name": "website-fe-01",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/website/fe-01/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:browser", "ring:adapter", "product:website"],
  "metadata": {
    "portability": {
      "visibility": "public",
      "dependencies": ["libs/website/domain/contracts"],
      "aliases": [],
      "packages": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "ai": "7.0.118",
        "jsdom": "^30.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "vite": "8.2.2"
      }
    }
  },
  "targets": {
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/docs/website/walkthrough.md"],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test ./apps/website/fe-01/src --timeout=30000"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/website/fe-01/src apps/website/fe-01/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/website/fe-01/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run dev",
        "cwd": "apps/website/fe-01"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run build",
        "cwd": "apps/website/fe-01"
      },
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
