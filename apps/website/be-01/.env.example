# Local demo: bind to loopback. DEMO_AUTH=1 answers the conversation with simulated replies and is
# refused on a public bind or non-loopback browser origin. There is no prospect sign-in: any OIDC_*
# setting stops the API at startup (ADR 0039).
WEBSITE_API_HOST=127.0.0.1
WEBSITE_API_PORT=3101
WEBSITE_DATABASE_PATH=.local/website.sqlite
PUBLIC_ORIGIN=http://localhost:4321
APP_ORIGIN=http://localhost:4201
DEMO_AUTH=1

# Set a private operator password to enable the local inbox. Empty means operator login returns 503.
OPERATOR_PASSWORD=

# Paid OpenRouter is disabled until the dedicated key, vetted model/provider, checked rates,
# privacy evidence, and explicit enable flag are all set. No model/provider is selected here.
OPENROUTER_ENABLED=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=
OPENROUTER_INPUT_USD_PER_MILLION=
OPENROUTER_OUTPUT_USD_PER_MILLION=
# Verified maximum effective rates across cache writes/reads and all applicable tiers.
# Required for paid readiness; absent keeps manual conversion available with inference unconfigured.
OPENROUTER_INPUT_CEILING_USD_PER_MILLION=
OPENROUTER_OUTPUT_CEILING_USD_PER_MILLION=
OPENROUTER_PRIVACY_VERIFIED=0

# Retention journal (no default): `disabled` keeps designation, hold and erasure routes at 503.
# `s3` also needs RETENTION_JOURNAL_ID, RETENTION_JOURNAL_BUCKET, RETENTION_JOURNAL_PREFIX,
# RETENTION_WRITER_RELEASE, RETENTION_WRITER_REVISION and the S3_* settings.
RETENTION_JOURNAL=disabled
