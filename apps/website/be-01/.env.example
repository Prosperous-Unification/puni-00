# Local demo: bind to loopback. DEMO_AUTH=1 is refused on a public bind or non-loopback browser origin.
WEBSITE_API_HOST=127.0.0.1
WEBSITE_API_PORT=3101
WEBSITE_DATABASE_PATH=.local/website.sqlite
PUBLIC_ORIGIN=http://localhost:4321
APP_ORIGIN=http://localhost:4201
DEMO_AUTH=1

# Set a private operator password to enable the local inbox. Empty means operator login returns 503.
OPERATOR_PASSWORD=

# Configurable real OIDC. All three are required; the callback must be the fixed API /session/oidc/callback route.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
OIDC_CLIENT_SECRET=

# Paid OpenRouter is disabled until the dedicated key, vetted model/provider, checked rates,
# privacy evidence, and explicit enable flag are all set. No model/provider is selected here.
OPENROUTER_ENABLED=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=
OPENROUTER_INPUT_USD_PER_MILLION=
OPENROUTER_OUTPUT_USD_PER_MILLION=
OPENROUTER_PRIVACY_VERIFIED=0
