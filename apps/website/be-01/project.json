{
  "name": "website-be-01",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/website/be-01/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun", "ring:adapter", "product:website"],
  "metadata": {
    "portability": {
      "visibility": "public",
      "dependencies": ["libs/website/domain/contracts", "libs/website/adapters/store-sqlite"],
      "aliases": [],
      "packages": {
        "@openrouter/ai-sdk-provider": "3.1.0",
        "ai": "7.0.118",
        "mmdb-lib": "3.0.3"
      }
    }
  },
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/openspec/changes/build-ai-chat-harness/system-prompt.md",
        "{workspaceRoot}/openspec/changes/conversion-scoping/system-prompt.md",
        "{workspaceRoot}/apps/website/fe-01/browser/conversation-api.mjs"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test ./apps/website/be-01/src --timeout=30000"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx eslint apps/website/be-01/src apps/website/be-01/build.ts apps/website/be-01/build-smoke.ts",
          "command -v shellcheck >/dev/null 2>&1 || { echo '[website-be-01] shellcheck is required but not installed. macOS: brew install shellcheck. Debian/Ubuntu: apt-get install shellcheck.' >&2; exit 1; }",
          "shellcheck -s bash bin/puni-website-dev-reset.sh bin/puni-website-dev-reset.test.sh bin/puni-website-local-reset.sh bin/puni-website-local-reset.test.sh"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/website/be-01/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "bun --watch src/main.ts",
        "cwd": "apps/website/be-01"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run apps/website/be-01/build.ts"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test:package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "bun run apps/website/be-01/build-smoke.ts"
      }
    }
  }
}
