{
  "name": "website-be-01",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/website/be-01/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "runtime:bun", "ring:adapter", "product:website"],
  "metadata": {
    "portability": {
      "visibility": "public",
      "dependencies": ["libs/website/domain/contracts", "libs/website/adapters/store-sqlite"],
      "aliases": [],
      "packages": {
        "@openrouter/ai-sdk-provider": "3.1.0",
        "ai": "7.0.118"
      }
    }
  },
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/openspec/changes/build-ai-chat-harness/system-prompt.md",
        "{workspaceRoot}/openspec/changes/conversion-scoping/system-prompt.md",
        "{workspaceRoot}/apps/website/fe-01/browser/conversation-api.mjs"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test ./apps/website/be-01/src --timeout=30000"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx eslint apps/website/be-01/src apps/website/be-01/build.ts apps/website/be-01/build-smoke.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsc --build --force apps/website/be-01/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "bun --watch src/main.ts",
        "cwd": "apps/website/be-01"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run apps/website/be-01/build.ts"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test:package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "bun run apps/website/be-01/build-smoke.ts"
      }
    }
  }
}
