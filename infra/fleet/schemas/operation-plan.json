{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puni.invalid/schemas/fleet-operation-plan.v1.json",
  "title": "Fleet operation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "desiredRevision",
    "observationDigest",
    "observedAt",
    "expiresAt",
    "request",
    "targetIdentities",
    "preconditions",
    "effects",
    "affectedCapabilities",
    "storageImplication",
    "downtimeImplication",
    "summary",
    "planSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "desiredRevision": { "type": "string", "minLength": 1 },
    "observationDigest": { "$ref": "#/$defs/sha256" },
    "observedAt": { "$ref": "#/$defs/instant" },
    "expiresAt": { "$ref": "#/$defs/instant" },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeId", "clusterId"],
          "properties": {
            "kind": { "const": "enroll" },
            "nodeId": { "$ref": "#/$defs/name" },
            "clusterId": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeId"],
          "properties": {
            "kind": { "enum": ["retire", "replace", "destroy"] },
            "nodeId": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeId", "version"],
          "properties": {
            "kind": { "const": "upgrade" },
            "nodeId": { "$ref": "#/$defs/name" },
            "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nodeId",
            "clusterId",
            "cloudAccount",
            "region",
            "machineType",
            "image",
            "network",
            "sshKeyIds",
            "retainedStorage",
            "budgetCapEur",
            "providerOwnershipId",
            "terraformPlanSha256",
            "terraformStateLineage",
            "terraformStateSerial"
          ],
          "properties": {
            "kind": { "const": "provision" },
            "nodeId": { "$ref": "#/$defs/name" },
            "clusterId": { "$ref": "#/$defs/name" },
            "cloudAccount": { "$ref": "#/$defs/name" },
            "region": { "$ref": "#/$defs/name" },
            "machineType": { "$ref": "#/$defs/name" },
            "image": { "$ref": "#/$defs/name" },
            "network": { "$ref": "#/$defs/name" },
            "sshKeyIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/name" }
            },
            "retainedStorage": { "type": "boolean" },
            "budgetCapEur": { "type": "number", "exclusiveMinimum": 0 },
            "providerOwnershipId": { "$ref": "#/$defs/name" },
            "terraformPlanSha256": { "$ref": "#/$defs/sha256" },
            "terraformStateLineage": { "$ref": "#/$defs/name" },
            "terraformStateSerial": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "targetIdentities": { "$ref": "#/$defs/nonemptyStrings" },
    "preconditions": { "$ref": "#/$defs/nonemptyStrings" },
    "effects": { "$ref": "#/$defs/nonemptyStrings" },
    "affectedCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["control-plane", "product", "ingress", "observability", "execution"]
      }
    },
    "storageImplication": { "$ref": "#/$defs/name" },
    "downtimeImplication": { "$ref": "#/$defs/name" },
    "summary": { "$ref": "#/$defs/name" },
    "planSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "instant": { "type": "string", "format": "date-time" },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/name" }
    }
  }
}
