[Unit]
Description=Lightweight Kubernetes
After=network-online.target puni-k3s-firewall.service
Wants=network-online.target puni-k3s-firewall.service

[Service]
Type=notify
ExecStart=/usr/local/bin/k3s server --config /etc/rancher/k3s/config.yaml
KillMode=process
Delegate=yes
LimitNOFILE=1048576
TasksMax=infinity
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
