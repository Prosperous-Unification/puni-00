server: {{ puni_registration_url }}
token-file: /etc/rancher/k3s/agent-token
node-name: {{ puni_node_name }}
node-ip: {{ puni_node_ip }}
flannel-iface: {{ puni_private_interface }}
node-taint:
  - puni.io/enrollment=pending:NoSchedule
node-label:
{% for capability in puni_node_capabilities %}
  - puni.dev/capability-{{ capability }}=true
{% endfor %}
# Pods never swap (Kubernetes NodeSwap defaults to NoSwap) while host services may use the fleet
# swap file. The reservations cap the kubepods cgroup below host memory, so the host's own
# services, such as h3mon's Victoria and MLflow, keep what the reservation names. Each default
# eviction threshold is restated because overriding one resets the others to zero.
kubelet-arg:
  - fail-swap-on=false
  - system-reserved=memory={{ puni_kubelet_system_reserved_memory }}
  - kube-reserved=memory={{ puni_kubelet_kube_reserved_memory }}
  - eviction-hard=memory.available<{{ puni_kubelet_eviction_memory }},nodefs.available<10%,imagefs.available<15%,nodefs.inodesFree<5%
