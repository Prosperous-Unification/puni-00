[Unit]
Description=Renew verified registry write permission every ten seconds
Requires=puni-registry-storage.service
After=puni-registry-storage.service k3s.service

[Service]
Type=simple
User=puni-registry-authority
Group=puni-registry-authority
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/puni-registry/journal/contents
ExecStart=/usr/local/libexec/puni-registry-authority/bun /usr/local/libexec/puni-registry-authority/authority.js /var/lib/puni-registry/journal/contents --monitor
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
