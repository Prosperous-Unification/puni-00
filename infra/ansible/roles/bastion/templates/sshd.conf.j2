# Named so that sshd reads it before every other drop-in: sshd keeps the first value of each
# option, so a later file cannot widen these (separate-node-roles, slice 1.9).
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PubkeyAuthentication yes
# Six: an agent offering several keys fails before the right one at three. The controller
# sets IdentitiesOnly=yes and names the one key (tasks/fresh-connection.yml).
MaxAuthTries 6
AllowUsers {{ puni_operator_name }} jump
DenyUsers {{ puni_console_account }}

# `jump` holds the jump key alone and forwards to each server's port 22 and nothing else.
Match User jump
  PermitTTY no
  AllowAgentForwarding no
  X11Forwarding no
  AllowStreamLocalForwarding no
  PermitTunnel no
  AllowTcpForwarding local
  PermitOpen {{ puni_bastion_permit_open | join(' ') }}
